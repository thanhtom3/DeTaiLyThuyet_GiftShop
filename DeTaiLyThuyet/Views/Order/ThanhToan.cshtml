@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh toán - Gift Shop</title>
    <link href="~/Content/css/style.css" rel="stylesheet" />
</head>
<body>
    <div id="header"></div>

    <div class="vung">
        <h2 class="tieude">Thanh toán</h2>
        <div id="tomTat"></div>

        <div class="hop">
            <h2>Thông tin giao hàng</h2>
            <label>Họ tên</label>
            <input type="text" id="ten" />
            <label>Số điện thoại</label>
            <input type="text" id="sdt" />
            <label>Địa chỉ</label>
            <input type="text" id="diaChi" />
            <label>Phương thức thanh toán</label>
            <select id="ptt">
                <option>Thanh toán khi nhận hàng</option>
                <option>Chuyển khoản ngân hàng</option>
            </select>
            <button class="nut" onclick="datHang()">Đặt hàng</button>
        </div>
    </div>

    <div id="footer"></div>

    <script src="~/Scripts/js/main.js"></script>
    <script>
        if (!nguoiDangNhap()) {
            alert("Vui lòng đăng nhập để thanh toán");
            location.href = "@Url.Action("DangNhap", "Account")";
        }

        var g = layGio();
        var tong = 0;
        var h = '<table class="bang"><tr><th>Sản phẩm</th><th>Số lượng</th><th>Thành tiền</th></tr>';
        for (var i = 0; i < g.length; i++) {
            var s = timSP(g[i].ma);
            tong += s.gia * g[i].sl;
            h += '<tr><td>' + s.ten + '</td><td>' + g[i].sl + '</td><td>' + dinhDang(s.gia * g[i].sl) + '</td></tr>';
        }
        h += '</table><div class="tong">Tổng cộng: ' + dinhDang(tong) + '</div>';
        if (g.length == 0) h = '<p>Giỏ hàng trống.</p>';
        document.getElementById("tomTat").innerHTML = h;

        function datHang() {
            var u = nguoiDangNhap();
            var gio = layGio();
            if (gio.length == 0) { alert("Giỏ hàng trống"); return; }

            var ten = document.getElementById("ten").value.trim();
            var sdt = document.getElementById("sdt").value.trim();
            var dc = document.getElementById("diaChi").value.trim();
            var ptt = document.getElementById("ptt").value;
            if (ten == "" || sdt == "" || dc == "") { alert("Vui lòng nhập đủ thông tin"); return; }

            var ct = [];
            var tongTien = 0;
            for (var i = 0; i < gio.length; i++) {
                var sp = timSP(gio[i].ma);
                ct.push({ ten: sp.ten, gia: sp.gia, sl: gio[i].sl });
                tongTien += sp.gia * gio[i].sl;
            }

            var ds = doc("donHang", []);
            ds.push({
                ma: "DH" + (ds.length + 1001),
                email: u.email,
                ngay: new Date().toLocaleString("vi-VN"),
                ten: ten, sdt: sdt, diaChi: dc, thanhToan: ptt,
                chiTiet: ct, tong: tongTien
            });
            ghi("donHang", ds);
            localStorage.removeItem("gioHang");
            alert("Đặt hàng thành công!");
            location.href = "@Url.Action("DonHang", "Order")";
        }
    </script>
</body>
</html>