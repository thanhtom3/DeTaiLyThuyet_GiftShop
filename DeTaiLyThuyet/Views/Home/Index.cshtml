@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang chủ - Gift Shop</title>
    <link rel="stylesheet" href="~/Content/css/style.css">
</head>
<body>
    <header>
        <a class="logo" href="~/Home/Index">🎁 Gift Shop</a>
        <nav>
            <a href="~/Home/Index">Trang chủ</a>
            <a href="~/Product/SanPham">Sản phẩm</a>
            <a href="~/Home/Combo">Combo</a>
            <a href="~/Home/LienHe">Liên hệ</a>
            <a href="~/Account/DangNhap">Đăng nhập</a>
            <a href="~/Cart/GioHang">Giỏ hàng (<span id="cart-count">0</span>)</a>
        </nav>
    </header>
    <main>
        <section class="banner">
            <h1>Văn phòng phẩm &amp; Quà lưu niệm</h1>
            <p>Mua lẻ hoặc theo combo, tiết kiệm đến 30%</p>
            <a class="btn" href="~/Home/Combo">Xem combo ngay</a>
        </section>
        <section>
            <h2>Danh mục sản phẩm</h2>
            <ul class="cats">
                <li><a href="~/Product/SanPham?loai=so-tay">📒 Sổ tay</a></li>
                <li><a href="~/Product/SanPham?loai=but">🖊️ Bút</a></li>
                <li><a href="~/Product/SanPham?loai=dung-cu">📏 Dụng cụ học tập</a></li>
                <li><a href="~/Product/SanPham?loai=qua-luu-niem">🎀 Quà lưu niệm</a></li>
            </ul>
        </section>
        <section>
            <h2>Sản phẩm nổi bật</h2>
            <div class="grid" id="featured"></div>
        </section>
        <section>
            <h2>Combo ưu đãi</h2>
            <div class="grid" id="combos"></div>
        </section>
    </main>
    <footer><p>&copy; 2026 Gift Shop | Hotline: 0900 000 000 | Quận 4, TP.HCM</p></footer>
    <script src="~/js/main.js"></script>
</body>
</html>