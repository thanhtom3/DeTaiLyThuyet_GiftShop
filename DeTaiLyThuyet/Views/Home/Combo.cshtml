@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Combo - Gift Shop</title>
    <link href="~/Content/css/style.css" rel="stylesheet" />
</head>
<body>
    <div id="header"></div>

    <div class="vung">
        <h2 class="tieude">Combo tiết kiệm</h2>
        <div id="dsMoTa"></div>
        <div class="luoi" id="ds"></div>
    </div>

    <div id="footer"></div>

    <script src="~/Scripts/js/main.js"></script>
    <script>
        var combo = layDS(true);
        var h = "<ul>";
        for (var i = 0; i < combo.length; i++) {
            h += "<li><b>" + combo[i].ten + ":</b> " + combo[i].mota + "</li>";
        }
        h += "</ul>";
        document.getElementById("dsMoTa").innerHTML = h;
        veSP(combo, "ds");
    </script>
</body>
</html>