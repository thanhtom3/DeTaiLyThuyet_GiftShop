@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Gift Shop</title>
    <link rel="stylesheet" href="~/Content/css/style.css">
</head>
<body>
    <header>
        <a class="logo" href="~/Home/Index">🎁 Gift Shop</a>
        <nav>
            <a href="~/Home/Index">Trang chủ</a>
            <a href="~/Product/SanPham">Sản phẩm</a>
            <a href="~/Home/Combo">Combo</a>
            <a href="~/Home/LienHe">Liên hệ</a>
            <a href="~/Account/DangNhap">Đăng nhập</a>
            <a href="~/Cart/GioHang">Giỏ hàng (<span id="cart-count">0</span>)</a>
        </nav>
    </header>
    <main>
        <h1>Đăng nhập / Đăng ký</h1>
        <div class="two">
            <form id="login-form" action="#">
                <fieldset>
                    <legend>Đăng nhập</legend>
                    <label for="dn-mail">Email</label>
                    <input type="email" id="dn-mail" required>
                    <label for="dn-mk">Mật khẩu</label>
                    <input type="password" id="dn-mk" required>
                    <button type="submit">Đăng nhập</button>
                    <p class="err" id="dn-msg"></p>
                </fieldset>
            </form>
            <form id="register-form" action="#">
                <fieldset>
                    <legend>Đăng ký</legend>
                    <label for="dk-ten">Họ tên</label>
                    <input type="text" id="dk-ten" required>
                    <label for="dk-mail">Email</label>
                    <input type="email" id="dk-mail" required>
                    <label for="dk-mk">Mật khẩu (tối thiểu 6 ký tự)</label>
                    <input type="password" id="dk-mk" minlength="6" required>
                    <button type="submit">Đăng ký</button>
                    <p class="err" id="dk-msg"></p>
                </fieldset>
            </form>
        </div>
    </main>
    <footer><p>&copy; 2026 Gift Shop | Hotline: 0900 000 000 | Quận 4, TP.HCM</p></footer>
    <script src="~/js/main.js"></script>
</body>
</html>