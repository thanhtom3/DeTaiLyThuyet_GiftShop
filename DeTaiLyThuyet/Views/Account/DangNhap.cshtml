@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - Gift Shop</title>
    <link href="~/Content/css/style.css" rel="stylesheet" />
</head>
<body>
    <div id="header"></div>

    <div class="vung">
        <div class="hop" id="formDangNhap">
            <h2>Đăng nhập</h2>
            <label>Email</label>
            <input type="text" id="dnEmail" />
            <label>Mật khẩu</label>
            <input type="password" id="dnMatKhau" />
            <button class="nut" onclick="xuLyDangNhap()">Đăng nhập</button>
            <p>Chưa có tài khoản? <a href="#" onclick="chuyenForm(false);return false;"><b>Đăng ký</b></a></p>
        </div>

        <div class="hop" id="formDangKy" style="display:none;">
            <h2>Đăng ký</h2>
            <label>Họ tên</label>
            <input type="text" id="dkTen" />
            <label>Email</label>
            <input type="text" id="dkEmail" />
            <label>Mật khẩu</label>
            <input type="password" id="dkMatKhau" />
            <label>Nhập lại mật khẩu</label>
            <input type="password" id="dkNhapLai" />
            <button class="nut" onclick="xuLyDangKy()">Đăng ký</button>
            <p>Đã có tài khoản? <a href="#" onclick="chuyenForm(true);return false;"><b>Đăng nhập</b></a></p>
        </div>
    </div>

    <div id="footer"></div>

    <script src="~/Scripts/js/main.js"></script>
    <script>
        function chuyenForm(hienDangNhap) {
            document.getElementById("formDangNhap").style.display = hienDangNhap ? "block" : "none";
            document.getElementById("formDangKy").style.display = hienDangNhap ? "none" : "block";
        }

        function xuLyDangKy() {
            var ten = document.getElementById("dkTen").value.trim();
            var email = document.getElementById("dkEmail").value.trim().toLowerCase();
            var mk = document.getElementById("dkMatKhau").value;
            var nl = document.getElementById("dkNhapLai").value;

            if (ten == "" || email == "" || mk == "") { alert("Vui lòng nhập đủ thông tin"); return; }
            if (email.indexOf(" ") < 0) { alert("Email không hợp lệ"); return; }
            if (mk.length < 6) { alert("Mật khẩu phải từ 6 ký tự"); return; }
            if (mk != nl) { alert("Mật khẩu nhập lại không khớp"); return; }

            var ds = doc("nguoiDung", []);
            for (var i = 0; i < ds.length; i++) {
                if (ds[i].email == email) { alert("Email này đã được đăng ký"); return; }
            }
            ds.push({ ten: ten, email: email, matKhau: mk });
            ghi("nguoiDung", ds);
            alert("Đăng ký thành công, hãy đăng nhập");
            chuyenForm(true);
        }

        function xuLyDangNhap() {
            var email = document.getElementById("dnEmail").value.trim().toLowerCase();
            var mk = document.getElementById("dnMatKhau").value;
            var ds = doc("nguoiDung", []);
            for (var i = 0; i < ds.length; i++) {
                if (ds[i].email == email && ds[i].matKhau == mk) {
                    ghi("dangNhap", email);
                    location.href = "@Url.Action("Index", "Home")";
                    return;
                }
            }
            alert("Sai email hoặc mật khẩu");
        }
    </script>
</body>
</html>