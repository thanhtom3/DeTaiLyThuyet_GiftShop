@model IEnumerable<DeTaiLyThuyet.Models.SanPham>

@{
    ViewBag.Title = "Quản lý hàng hóa";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Quản lý hàng hóa</h2>

<p>
    @Html.ActionLink("Thêm sản phẩm", "Create", null,
            new { @class = "btn btn-primary" })
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Số lượng tồn</th>
            <th>Phân loại</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!String.IsNullOrEmpty(item.HinhAnh))
                    {
                        var duongDanAnh = item.HinhAnh.StartsWith("/")
                            ? "~" + item.HinhAnh
                            : "~/Content/images/" + item.HinhAnh;

                        <img src="@Url.Content(duongDanAnh)"
                             alt="@item.TenSanPham"
                             style="width:80px;height:80px;object-fit:cover;" />
                    }
                    else
                    {
                        <span>Chưa có ảnh</span>
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.TenSanPham)</td>
                <td>@item.Gia.ToString("N0") đ</td>
                <td>@Html.DisplayFor(modelItem => item.SoLuongTon)</td>

                <td>
                    @(item.DanhMuc != null
                        ? item.DanhMuc.TenDanhMuc
                        : "Chưa phân loại")
                </td>

                <td>
                    @Html.ActionLink("Sửa", "Edit",
                             new { id = item.SanPhamID }) |
                    @Html.ActionLink("Chi tiết", "Details",
                             new { id = item.SanPhamID }) |
                    @Html.ActionLink("Xóa", "Delete",
                             new { id = item.SanPhamID })
                </td>
            </tr>
        }
    </tbody>
</table>