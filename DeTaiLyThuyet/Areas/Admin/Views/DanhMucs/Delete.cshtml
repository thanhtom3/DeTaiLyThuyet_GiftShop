@model DeTaiLyThuyet.Models.DanhMuc

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Xóa danh mục</h2>

<h3>Bạn có chắc chắn muốn xóa danh mục này không?</h3>
<div>
    <h4>Thông tin danh mục</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            Mã loại
        </dt>

        <dd>
            @Html.DisplayFor(model => model.MaLoai)
        </dd>

        <dt>
            Tên danh mục
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TenDanhMuc)
        </dd>

    </dl>

    @using (Html.BeginForm("Delete", "DanhMucs",
        new { id = Model.DanhMucID }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Xóa danh mục"
                   class="btn btn-danger" />
            @Html.ActionLink("Hủy", "Index", null,
                new { @class = "btn btn-default" })
        </div>
    }
</div>
